# clocket-league config — copy to ".env" and edit. Flags override these.
# Only set what you need for your chosen --source / --transport.

# --- which mode -------------------------------------------------------------
CL_SOURCE=rl            # rl | demo | showcase
CL_TRANSPORT=http       # http | mqtt

# --- http transport (default): just your clock's IP -------------------------
CLOCK_HOST=192.168.1.50

# --- look & feel ------------------------------------------------------------
CL_TEAM_NAMES=normalize # normalize (BLUE/ORANGE WINS) | actual (real team name)
CL_SCREENS=score-time   # rotate: score-time,score,time,boost,boost-team
CL_SWAP_SECS=10         # seconds per screen when CL_SCREENS lists more than one
CL_IDLE=waiting         # between matches: waiting (hold WAITING FOR MATCH) | release (normal clock face, only take over for a live match — best for always-on)
# CL_DISABLE=post        # comma list: countdown,goal,post,overtime,urgency
# RL_PLAYER_NAME=@YourName       # needed for the boost / boost-team screens
# RL_PLAYER_PRIMARY_ID=Steam|7656...|0

# --- rl source (default): RL's local Stats API socket -----------------------
# RL_HOST=127.0.0.1
# RL_PORT=49123

# --- mqtt transport ---------------------------------------------------------
# MQTT_HOST=192.168.1.10
# MQTT_PORT=1883
# MQTT_USER=
# MQTT_PASS=
# AWTRIX_PREFIX=awtrix        # the clock's uid prefix, e.g. awtrix_11d5f8

# --- demo -------------------------------------------------------------------
# CL_DEMO_SPEED=1.0
